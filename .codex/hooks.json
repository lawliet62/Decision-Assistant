    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/worktree-guard.mjs\"", "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/scripts/worktree-guard.mjs')\"" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/worktree-guard.mjs\"", "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/scripts/worktree-guard.mjs')\"", "timeout": 3 }] }]

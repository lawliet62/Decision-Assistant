{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/cleanup-merged-worktrees.mjs\" --hook",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}

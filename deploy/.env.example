# 비밀 아닌 예시다. 실제 allowlist는 저장소에 commit하지 않는다.
PUBLIC_HOST=decision.example.com
ACME_EMAIL=acme@example.com
DEV_PROJECT_ID=example-decision-dev
PROD_PROJECT_ID=example-decision-prod
DB_SECRET_VERSION=1
AUTH0_SECRET_VERSION=1
AUTH0_CLIENT_ID=example-client
AUTH0_ISSUER_URI=https://example.auth0.com/
ALLOWED_EMAILS=reviewer@example.com

# 복원 후 실제 기준 시각을 ISO-8601 UTC로 지정 (평상시 빈 값)
DECISION_ASSISTANT_RECOVERY_RESTORED_TO=

# Reference only: this file is not loaded automatically.
# For a minimal local backend/.env and explicit loading, see docs/development.md.
# This example includes production OIDC settings; do not copy them unchanged for local use.
DB_URL=jdbc:postgresql://localhost:5432/decision_assistant
DB_USERNAME=decision_assistant
DB_PASSWORD=decision_assistant

# Production authentication (Auth0 Regular Web Application).
SPRING_PROFILES_ACTIVE=oidc
AUTH0_ISSUER_URI=https://your-tenant.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
DECISION_ASSISTANT_PUBLIC_BASE_URL=https://decision-assistant.example.com
# Exact, case-insensitive email allowlist. Wildcards and domains are not supported.
DECISION_ASSISTANT_ALLOWED_EMAILS=person@example.com,second@example.com

# Gemini Developer API is the dogfooding default; AI is enabled in application.yaml.
# Its free tier can use submitted content to improve Google products. Send only
# product information and general purchase notes; never send sensitive data.
DECISION_ASSISTANT_AI_ENABLED=true
DECISION_ASSISTANT_AI_PROVIDER=gemini
DECISION_ASSISTANT_AI_MODEL=gemini-3.5-flash-lite
AI_CHAT_PROVIDER=google-genai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional product-name lookup (Serper). Separate from Firecrawl page import.
SERPER_API_KEY=
DECISION_ASSISTANT_SEARCH_ENABLED=false
# Server-wide UTC monthly cap, 1..1000. Failed calls also consume this budget.
DECISION_ASSISTANT_SEARCH_MONTHLY_LIMIT=1000

# Optional guided public-page import and existing candidate discovery (Firecrawl).
# Enable with a key to collect selected pages; Serper alone does not collect them.
FIRECRAWL_API_KEY=
DECISION_ASSISTANT_WEB_ENABLED=false

# Optional outcome reminder delivery. Verify the sender domain before enabling.
RESEND_API_KEY=
DECISION_ASSISTANT_REMINDERS_ENABLED=false
DECISION_ASSISTANT_FROM_EMAIL=Decision Assistant <reminders@example.com>

# Optional OpenAI alternative. Set all values above for this provider instead.
# DECISION_ASSISTANT_AI_PROVIDER=openai
# DECISION_ASSISTANT_AI_MODEL=gpt-5.4-nano
# AI_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano

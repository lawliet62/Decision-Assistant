DB_URL=jdbc:postgresql://localhost:5432/decision_assistant
DB_USERNAME=decision_assistant
DB_PASSWORD=decision_assistant

# Production authentication (Auth0 Regular Web Application).
SPRING_PROFILES_ACTIVE=oidc
AUTH0_ISSUER_URI=https://your-tenant.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
DECISION_ASSISTANT_PUBLIC_BASE_URL=https://decision-assistant.example.com
# Exact, case-insensitive email allowlist. Wildcards and domains are not supported.
DECISION_ASSISTANT_ALLOWED_EMAILS=person@example.com,second@example.com

# AI is disabled by default. Gemini Developer API is the dogfooding default.
# Its free tier can use submitted content to improve Google products. Send only
# product information and general purchase notes; never send sensitive data.
DECISION_ASSISTANT_AI_ENABLED=true
DECISION_ASSISTANT_AI_PROVIDER=gemini
DECISION_ASSISTANT_AI_MODEL=gemini-3.5-flash-lite
AI_CHAT_PROVIDER=google-genai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI alternative. Set all values above for this provider instead.
# DECISION_ASSISTANT_AI_PROVIDER=openai
# DECISION_ASSISTANT_AI_MODEL=gpt-5.4-nano
# AI_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano

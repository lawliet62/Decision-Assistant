# NON-SECRET configuration only. Not automatically loaded.
# node --env-file=backend/.env scripts/gradle.mjs bootRun
# Real API keys/passwords belong in GCP Secret Manager, never this file.
# Onboarding: docs/development.md; IAM/production: docs/deployment.md.
SPRING_PROFILES_ACTIVE=local
DECISION_ASSISTANT_SECRETS_MODE=offline
DECISION_ASSISTANT_PUBLIC_BASE_URL=http://localhost:3000
DB_URL=jdbc:postgresql://localhost:5432/decision_assistant
DB_USERNAME=decision_assistant

# For real local API calls: use gcloud auth application-default login,
# change mode to gcp, set distinct project IDs and enable selected features.
DECISION_ASSISTANT_SECRETS_DEV_PROJECT_ID=your-decision-dev
DECISION_ASSISTANT_SECRETS_PROD_PROJECT_ID=your-decision-prod
DECISION_ASSISTANT_SEARCH_ENABLED=false
DECISION_ASSISTANT_SEARCH_MONTHLY_LIMIT=1000
SERPER_SECRET_VERSION=1
DECISION_ASSISTANT_WEB_ENABLED=false
DECISION_ASSISTANT_CATALOG_ENABLED=true
DECISION_ASSISTANT_CATALOG_REFRESH_ENABLED=false
DECISION_ASSISTANT_CATALOG_SPEC_REFRESH_ENABLED=false
DECISION_ASSISTANT_CATALOG_MONTHLY_LIMIT=200
# Price refresh needs WEB_ENABLED=true and managed Firecrawl credentials.
# Catalog operations: docs/catalog-operations.md
FIRECRAWL_SECRET_VERSION=1
DECISION_ASSISTANT_AI_ENABLED=false
DECISION_ASSISTANT_AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SECRET_VERSION=1
# Optional AI alternative: provider=openai, matching AI model and version.
# DECISION_ASSISTANT_AI_MODEL=gpt-5.4-nano
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_SECRET_VERSION=1
DECISION_ASSISTANT_REMINDERS_ENABLED=false
RESEND_SECRET_VERSION=1
DECISION_ASSISTANT_FROM_EMAIL=Decision Assistant <reminders@example.com>

# Production: use oidc (never local,test), mode=gcp and production DB/origin.
# AUTH0_ISSUER_URI=https://your-tenant.auth0.com/
# AUTH0_CLIENT_ID=your-public-client-id
# DECISION_ASSISTANT_ALLOWED_EMAILS=owner@example.com
# AUTH0_SECRET_VERSION=1
# DB_SECRET_VERSION=1
# Shared Dev DB also requires DB_SECRET_VERSION and SPRING_DOCKER_COMPOSE_ENABLED=false.
# Secret names are fixed (e.g. serper-api-key); only numeric versions are accepted.
# AI_CHAT_PROVIDER is no longer used: the selected AI provider determines its client.
